---
import { LOCALES, homePath, type Locale } from '@/i18n/config.ts';

interface Props {
  locale: Locale;
  label: string;
}

const { locale, label } = Astro.props;
const NAMES: Record<Locale, { short: string; long: string }> = {
  es: { short: 'ES', long: 'Español' },
  en: { short: 'EN', long: 'English' },
};
---

<nav class="toggle" aria-label={label}>
  {
    LOCALES.map((l) => (
      <a
        href={homePath(l)}
        hreflang={l}
        lang={l}
        aria-current={l === locale ? 'page' : undefined}
        aria-label={NAMES[l].long}
      >
        {NAMES[l].short}
      </a>
    ))
  }
</nav>

<style>
  .toggle {
    display: inline-flex;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 3px;
    background: var(--surface);
  }
  a {
    font-family: var(--font-data);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-2);
    padding: 4px 12px;
    border-radius: 999px;
    min-width: 44px;
    text-align: center;
    transition: background-color 160ms ease, color 160ms ease;
  }
  a:hover {
    color: var(--ink);
  }
  a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>
