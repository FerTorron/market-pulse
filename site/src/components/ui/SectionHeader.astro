---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  /** The title may contain inline HTML produced from the story markdown (links, emphasis). */
  html?: boolean;
}

const { id, title, eyebrow, html = false } = Astro.props;
---

<header class="section-header">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  {html ? <h2 id={id} set:html={title} /> : <h2 id={id}>{title}</h2>}
</header>

<style>
  .section-header {
    display: grid;
    gap: 8px;
    margin-bottom: 24px;
  }
  .eyebrow {
    font-family: var(--font-data);
    font-size: var(--step--1);
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  h2 {
    font-size: var(--step-2);
    font-weight: 700;
  }
</style>
