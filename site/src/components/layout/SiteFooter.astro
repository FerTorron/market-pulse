---
import { SITE } from '@/config/site.ts';
import type { Messages } from '@/i18n/translations.ts';

interface Props {
  t: Messages['footer'];
  dataNote: string;
}

const { t, dataNote } = Astro.props;
---

<footer class="site-footer">
  <div class="page inner">
    <p class="author">
      {t.madeBy}{' '}<a href={SITE.portfolioUrl} rel="author">{SITE.author}</a>
    </p>
    <ul class="links">
      <li><a href={SITE.portfolioUrl}>{t.portfolio}</a></li>
      <li><a href={SITE.repoUrl}>{t.repo}</a></li>
    </ul>
    <p class="note">{dataNote} {t.disclaimer}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--rule);
    background: var(--surface);
  }
  .inner {
    display: grid;
    gap: 12px;
    padding-block: 32px 40px;
  }
  .author {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
  }
  .author a {
    text-decoration-color: var(--series-2);
    text-decoration-thickness: 2px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-data);
    font-size: var(--step--1);
  }
  .note {
    font-family: var(--font-data);
    font-size: var(--step--1);
    color: var(--ink-3);
    max-width: 72ch;
  }
</style>
