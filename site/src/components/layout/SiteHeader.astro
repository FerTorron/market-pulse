---
import LanguageToggle from '@/components/ui/LanguageToggle.astro';
import type { Locale } from '@/i18n/config.ts';
import type { Messages } from '@/i18n/translations.ts';

interface Props {
  locale: Locale;
  t: Messages['header'];
}

const { locale, t } = Astro.props;
---

<a class="skip" href="#main">{t.skipToContent}</a>
<header class="site-header page">
  <p class="brand">
    <svg viewBox="0 0 32 20" aria-hidden="true"><path d="M1 6 L8 9 L12 8 L17 17 L22 11 L31 14" /></svg>
    {t.brand}
  </p>
  <LanguageToggle locale={locale} label={t.languageNav} />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-0);
    letter-spacing: -0.02em;
  }
  svg {
    width: 28px;
    height: 18px;
    fill: none;
    stroke: var(--series-2);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    background: var(--ink);
    color: var(--paper);
    padding: 8px 12px;
    border-radius: var(--radius);
    z-index: 10;
  }
  .skip:focus {
    top: 12px;
  }
</style>
