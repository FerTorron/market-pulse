{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@pipeline/*": ["../scripts/lib/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "../scripts/lib/**/*"],
  "exclude": ["dist"]
}
